#!/bin/rc
echo T.arnold: test fixes by Arnold Robbins 8/18
# for which many thanks

rm -rf arnold-fixes
tar xf arnold-fixes.tar
cd arnold-fixes

for(i in *.awk){
	name=`{basename $i .awk}
	if(! ~ $name system-status){
		$awk -f $name.awk >foo.$name
		diff $name.ok foo.$name || echo 'BAD: T.arnold ('^$name^')'
	}
}
