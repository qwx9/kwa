#!/bin/rc
rfork e
if(~ $#oldawk 0)
	oldawk=trueawk
if(~ $#awk 0)
	awk=kwa

working=(\
	T.-f-f \
	T.chem \
	T.csconcat \
	T.delete \
	T.exprconv \
	T.fmt \
	T.getline \
	T.lilly \
	T.main \
	T.redir \
	T.system \
)

broken=(\
	T.argv \
	T.arnold \
	T.builtin \
	T.close \
	T.clv \
	T.errmsg \
	T.expr \
	T.flags \
	T.func \
	T.int-expr \
	T.latin1 \
	T.misc \
	T.nextfile \
	T.overflow \
	T.re \
	T.recache \
	T.split \
	T.sub \
	T.utf \
	T.utfre \
)

for(i in $working)
	./$i
echo known broken
for(i in $broken)
	./$i
